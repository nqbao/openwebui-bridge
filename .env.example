# Copy to .env beside profiles.toml, fill in values, then restart the bridge.
# Existing environment variables take precedence over this file.
PROXY_API_KEY=choose-a-private-key
OPENWEBUI_API_KEY=your-openwebui-user-api-key
# Optional, if using API authentication instead of Claude host login:
# ANTHROPIC_API_KEY=your-anthropic-api-key
